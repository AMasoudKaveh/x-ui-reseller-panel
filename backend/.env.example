# X-UI full panel URL, including the web base path if your panel uses one.
# Example: https://203.0.113.10:2053/randomPanelPath
XUI_BASE_URL=
XUI_API_TOKEN=
XUI_USERNAME=
XUI_PASSWORD=
XUI_VERIFY_TLS=false

# Optional fallback only. The UI normally loads live inbounds from x-ui.
DEFAULT_INBOUND_IDS=

# Live traffic/online refresh interval.
POLL_SECONDS=10

# Used only once when a fresh database has no admin account.
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=

# This release serves HTTP by default on a user-selected port.
SESSION_COOKIE_SECURE=false
ENABLE_LIVE_PROBE=false
PANEL_PUBLIC_PORT=8088
